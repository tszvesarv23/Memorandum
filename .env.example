# ── Base de datos ─────────────────────────────────────────────
# Producción/desarrollo con Postgres real:
# DATABASE_URL="postgres://memorandum:memorandum@localhost:5432/memorandum"
# Desarrollo local sin instalar nada (Postgres embebido, datos en ./.data):
DATABASE_URL="pglite:./.data/memorandum"

# ── Almacenamiento S3-compatible (Cloudflare R2) ──────────────
# Prefijos/buckets separados: public-media, private-submissions,
# processed-media, archives
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC="memorandum-public-media"
R2_BUCKET_PRIVATE="memorandum-private-submissions"
R2_PUBLIC_HOSTNAME="media.example.com"

# ── Anti-spam (Cloudflare Turnstile) ──────────────────────────
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Autenticación del panel /admin ────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_SESSION_TTL_SECONDS="28800"
# Sal para el hash de IPs del buzón (nunca se guarda la IP en claro)
IP_HASH_SALT=""
# Credenciales del primer usuario admin (solo para db:seed)
ADMIN_EMAIL="admin@memorandum.local"
ADMIN_PASSWORD=""

# ── Observabilidad ────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Memorandum"
